# =============================================================================
# COIA — Arquivo de variáveis de ambiente (template)
# Copie este arquivo para .env e preencha os valores antes de usar.
# =============================================================================


# =============================================================================
# GCP / VERTEX AI (núcleo do COIA)
# =============================================================================

# ID do projeto GCP onde o Vertex AI está habilitado
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID

# Região do Vertex AI
GCP_LOCATION=us-east5

MODEL_GEMINI_FLASH=gemini-1.5-flash
MODEL_GEMINI=gemini-1.5-pro
MODEL_GEMINI_PRO=gemini-1.5-pro

# =============================================================================
# LOG
# Nível de log da aplicação: debug | info | warn | error
# =============================================================================

LOG_LEVEL=error


# =============================================================================
# MCP — BITBUCKET
# Integração com repositórios, pull requests e pipelines do Bitbucket.
# Gere o App Password em: bitbucket.org → Settings → App passwords → Create
# Permissões mínimas: Repositories (Read/Write), Pull requests (Read/Write)
# =============================================================================

BITBUCKET_USERNAME=your.username@yourdomain.com
BITBUCKET_APP_PASSWORD=YOUR_BITBUCKET_APP_PASSWORD


# =============================================================================
# MCP — JIRA
# Integração com issues, sprints e transições do Jira (Atlassian Cloud).
# Gere o token em: id.atlassian.net → Security → API tokens → Create API token
# =============================================================================

JIRA_USER_EMAIL=your.username@yourdomain.com
JIRA_SITE_NAME=your-atlassian-site-name
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN


# =============================================================================
# MCP — SLACK
# Integração com canais e mensagens do Slack.
# Crie o app em: api.slack.com → Your Apps → OAuth & Permissions
# Scopes mínimos: channels:read, chat:write, users:read
# SLACK_TEAM_ID: visível na URL do Slack — app.slack.com/client/TXXXXXXXX
# =============================================================================

SLACK_BOT_TOKEN=xoxb-YOUR_SLACK_BOT_TOKEN
SLACK_TEAM_ID=YOUR_SLACK_TEAM_ID


# =============================================================================
# MCP — MONGODB / AWS DOCUMENTDB
# URI de conexão ao banco. Use MONGO_URI (completa) ou MONGO_HOST + MONGO_PORT.
# Se usar DocumentDB com TLS, inclua o parâmetro tlsCAFile na URI.
# O bundle de CA global da AWS pode ser baixado em:
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# Salve-o em: /home/YOUR_USERNAME/.aws/global-bundle.pem
# =============================================================================

MONGO_URI=mongodb://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:27017/?authSource=admin&tls=true&tlsCAFile=%2Fhome%2FYOUR_USERNAME%2F.aws%2Fglobal-bundle.pem
MONGO_DB_NAME=YOUR_DATABASE_NAME

# Alternativa: conexão por host/porta separados (usado se MONGO_URI não estiver definida)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017


# =============================================================================
# MCP — AWS
# Perfil e região para o servidor MCP de CDK/infraestrutura AWS.
# Configure o perfil com: aws configure --profile YOUR_PROFILE_NAME
# Padrão do MCP se não definido: perfil "default", região "us-east-1"
# =============================================================================

AWS_PROFILE=YOUR_AWS_PROFILE_NAME
AWS_REGION=us-east-1


# =============================================================================
# MCP — BRAVE SEARCH
# Busca web em tempo real. Plano gratuito: até 2.000 req/mês.
# Obtenha em: brave.com/search/api → Sign up → Create API Key
# =============================================================================

BRAVE_API_KEY=YOUR_BRAVE_API_KEY


# =============================================================================
# MCP — TAVILY
# Busca web otimizada para LLMs. Plano gratuito: 1.000 req/mês.
# Obtenha em: app.tavily.com → Sign up → API Keys
# =============================================================================

TAVILY_API_KEY=YOUR_TAVILY_API_KEY


# =============================================================================
# MCP — FIRECRAWL
# Scraping avançado com suporte a JavaScript. Plano gratuito disponível.
# Obtenha em: firecrawl.dev → Sign up → API Keys
# =============================================================================

FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY


# =============================================================================
# MCP — NOTION
# Integração com páginas e databases do Notion.
# Crie a integração em: notion.so/my-integrations → New integration
# Após criar, compartilhe as páginas desejadas com a integração.
# =============================================================================

NOTION_API_KEY=YOUR_NOTION_API_KEY


# =============================================================================
# MCP — DEEPL
# Tradução profissional. Plano gratuito: 500.000 caracteres/mês.
# Obtenha em: deepl.com/pro-api → Sign up for free → Copy Authentication Key
# =============================================================================

DEEPL_API_KEY=YOUR_DEEPL_API_KEY


# =============================================================================
# MCP — ELEVENLABS
# Síntese de voz (TTS). Plano gratuito: 10.000 caracteres/mês.
# Obtenha em: elevenlabs.io → Sign up → Profile → API Key
# =============================================================================

ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY


# =============================================================================
# MCP — FAL.AI
# Geração de imagens e vídeos (Flux, Stable Diffusion, etc.). Pay-per-use.
# Obtenha em: fal.ai → Sign up → Dashboard → API Keys → Add Key
# =============================================================================

FAL_KEY=YOUR_FAL_AI_KEY


# =============================================================================
# MCP — IMAGE GENERATION (OpenAI / DALL-E)
# Geração e edição de imagens via DALL-E 3 / GPT-Image-1.
# Obtenha em: platform.openai.com → API Keys → Create new secret key
# =============================================================================

OPENAI_API_KEY=YOUR_OPENAI_API_KEY


# =============================================================================
# MCP — IMAGEN 3 (Google AI Studio)
# Geração de imagens fotorrealistas via Google Imagen 3. Plano gratuito disponível.
# Obtenha em: aistudio.google.com → Get API Key
# =============================================================================

GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY


# =============================================================================
# MCP — GMAIL
# Integração com Gmail via OAuth 2.0.
# Passo a passo:
#   1. console.cloud.google.com → seu projeto → APIs & Services → Enable Gmail API
#   2. Credentials → OAuth 2.0 Client ID → Desktop App → Baixe o JSON
#   3. Salve o arquivo baixado no caminho abaixo
#   4. Na primeira execução, o browser abrirá para autorizar o acesso
# Padrão do MCP se não definido: /home/YOUR_USERNAME/.coia/gmail-credentials.json
# =============================================================================

GMAIL_CREDENTIALS_PATH=/home/YOUR_USERNAME/.coia/gmail-credentials.json


# =============================================================================
# MCP — GOOGLE DRIVE
# Integração com Google Drive via OAuth 2.0.
# Passo a passo:
#   1. console.cloud.google.com → seu projeto → APIs & Services → Enable Drive API
#   2. Credentials → OAuth 2.0 Client ID → Desktop App → Baixe o JSON
#   3. Salve o arquivo baixado no caminho abaixo
#   4. Na primeira execução, o browser abrirá para autorizar o acesso
# Padrão do MCP se não definido: /home/YOUR_USERNAME/.coia/gdrive-credentials.json
# =============================================================================

GDRIVE_CREDENTIALS_PATH=/home/YOUR_USERNAME/.coia/gdrive-credentials.json


# =============================================================================
# MCP — MEMORY (memória persistente)
# Armazenamento local em arquivo JSON. Nenhuma chave de API necessária.
# Padrão do MCP se não definido: /home/YOUR_USERNAME/.coia/memory.json
# =============================================================================

MEMORY_FILE_PATH=/home/YOUR_USERNAME/.coia/memory.json
# =============================================================================

MEMORY_FILE_PATH=/home/YOUR_USERNAME/.coia/memory.json


# =============================================================================
# MCP — FETCH e YOUTUBE TRANSCRIPT
# Não requerem nenhuma variável de ambiente.
# fetch: converte qualquer URL em markdown limpo.
# youtube-transcript: extrai legendas de vídeos do YouTube.
# =============================================================================
